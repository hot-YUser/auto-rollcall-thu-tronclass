b93\u4f60\u5c07\u5b78\u7fd2\u5230\u7684\u7406\u8ad6\u8f49\u5316\u70ba\u5e36\u5f97\u8d70\u7684\u5be6\u6230\u529b\uff01</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u3010\u4e09\u968e\u6bb5\u95dc\u5361\u3011</span></p><p><span style=\"color: rgb(102, 102, 102);\"><b><u>\u7b2c\u4e00\u968e\u6bb5</u></b>\uff1a\u4f01\u756b\u8a3a\u65b7\u5206\u6790\uff1a\u73fe\u5834\u5c07\u62bd\u51fa 10 \u4efd\u771f\u5be6\u793e\u5718\u4f01\u756b\u66f8\uff0c\u4f60\u5fc5\u9808\u5f9e\u4e2d\u627e\u51fa\u4e0d\u7b26\u908f\u8f2f\u6216\u8cc7\u6e90\u932f\u7f6e\u7684\u7834\u7dbb\uff0c\u63ea\u51fa\u81f4\u547d\u50b7\uff0c\u62ff\u4e0b\u9ad8\u5206\uff01</span></p><p><span style=\"color: rgb(102, 102, 102);\"><b><u>\u7b2c\u4e8c\u968e\u6bb5</u></b>\uff1a\u9ed1\u5929\u9d5d\u4e8b\u4ef6\u6311\u6230\uff0c\u8b66\u5831\u97ff\u8d77\uff01\u5404\u7d44\u5c07\u62bd\u53d6\u5371\u6a5f\u5361\uff08\u4f8b\u5982\u6d3b\u52d5\u5e38\u898b\u554f\u984c\u6216\u91cd\u5927\u554f\u984c\uff0c\u5fc5\u9808\u63d0\u51fa\u6642\u9593\u8207\u57f7\u884c\u4e0a\u7686\u5408\u7406\u7684\u88dc\u6551\u65b9\u6848\u3002</span></p><p><span style=\"color: rgb(102, 102, 102);\">(\u9326\u56ca\u5999\u8a08\uff1a\u5361\u95dc\u6642\uff0c\u6bcf\u7d44\u5171\u6709 3\u6b21\u3001\u6bcf\u6b215\u5206\u9418 \u7684\u300c\u5b78\u9577\u59ca\u52a9\u529b\u300d\u6a5f\u6703\uff0c\u53ef\u5411\u5177\u5099\u5be6\u6230\u7d93\u9a57\u7684\u5b78\u9577\u59ca\u8acb\u76ca\u7834\u95dc\u65b9\u5411\uff01)</span></p><p><span style=\"color: rgb(102, 102, 102);\"><b><u>\u7b2c\u4e09\u968e\u6bb5</u></b>\uff1a\u4f01\u756b\u63d0\u6848\u554f\u7b54\uff0c\u900f\u904e\u5718\u968a\u8166\u529b\u6fc0\u76ea\uff0c\u4ee5\u624b\u5beb\u6d77\u5831\u7d19\u7522\u51fa 1 \u9801\u5168\u65b0\u7684\u4fee\u6b63\u4f01\u756b\u3002\u63a5\u8457\u5411\u8a55\u5be9\u63d0\u6848\uff0c\u6bcf\u4f4d\u6210\u54e1\u7686\u9808\u4e0a\u53f0\u89e3\u8aaa\u4e26\u63a5\u53d7\u8a55\u5be9\u554f\u7b54\u3002</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u3010\u734e\u52f5\u65b9\u5f0f\u3011</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u4f9d\u64da\u4e09\u968e\u6bb5\u7e3d\u7a4d\u5206\u6392\u540d\uff0c\u524d5\u540d\u5c0f\u7d44\u5c07\u7372\u5f97\u8c50\u539a\u734e\u91d1\u8207\u734e\u72c0\uff08\u7372\u734e\u540d\u55ae\u5c07\u65bc 115\u5e746\u670815\u65e5\u516c\u544a\uff09\uff1a</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u5927\u5e2b\u734e (1\u7d44)\uff1a\u7e3d\u734e\u91d1 12,000\u5143 \uff0b \u500b\u4eba\u734e\u72c0</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u5c08\u5bb6\u734e (2\u7d44)\uff1a\u7e3d\u734e\u91d1 9,000\u5143 \uff0b \u500b\u4eba\u734e\u72c0</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u6700\u4f73\u5718\u968a\u734e (2\u7d44)\uff1a\u7e3d\u734e\u91d1 7,500\u5143 \uff0b \u500b\u4eba\u734e\u72c0</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u3010\u5831\u540d\u8207\u6d3b\u52d5\u8cc7\u8a0a\u3011</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u6d3b\u52d5\u6642\u9593\uff1a115\u5e746\u67089\u65e5(\u4e8c) 18:00 - 22:00</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u6d3b\u52d5\u5730\u9ede\uff1a\u6de1\u6c34\u6821\u5712\u9ad4\u80b2\u9928 SG316 \u6559\u5ba4</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u7d44\u968a\u898f\u7bc4\uff1a3-5\u4eba\u70ba1\u5c0f\u968a\uff0c\u672a\u90543\u4eba\u4e0d\u4e88\u53d7\u7406\u3002\u53d7\u740610\u5c0f\u968a\u53c3\u8207\u6311\u6230\uff0c\u5831\u540d\u8d85\u904e\u7d44\u6578\u65bc6\u67083\u65e5(\u4e09)\u62bd\u7c64\u6c7a\u5b9a\u53c3\u52a0\u5c0f\u968a\u3002</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u5831\u540d\u671f\u9593\uff1a115\u5e745\u670826\u65e5(\u4e8c)\u8d77\u81f3 6\u67082\u65e5(\u4e8c) \u6b62</span></p><p><span style=\"color: rgb(102, 102, 102);\">\u5831\u540d\u65b9\u5f0f\uff1a\u8acb\u9078\u6d3e\u5c0f\u968a\u9577\uff0c\u81f3\u672c\u6821\u5831\u540d\u7cfb\u7d71\u5831\u540d\u4e26\u4e0a\u50b3\u968a\u54e1\u8cc7\u6599\u3002<br>\u5831\u540d\uff1a<a class=\"\" href=\"https://enroll.tku.edu.tw/course.aspx?cid=PLAN0609\" target=\"_blank\">https://enroll.t